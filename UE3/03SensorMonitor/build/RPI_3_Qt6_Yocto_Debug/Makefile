####### Compile

main.o: ../../main.cpp ../../mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

mainwindow.o: ../../mainwindow.cpp ../../mainwindow.h \
		../../sensormonitor.h \
		../../sensorboard.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../../mainwindow.cpp

sensorboard.o: ../../sensorboard.cpp ../../sensorboard.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o sensorboard.o ../../sensorboard.cpp

sensormonitor.o: ../../sensormonitor.cpp ../../sensormonitor.h \
		../../sensorboard.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o sensormonitor.o ../../sensormonitor.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_sensorboard.o: moc_sensorboard.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_sensorboard.o moc_sensorboard.cpp

moc_sensormonitor.o: moc_sensormonitor.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_sensormonitor.o moc_sensormonitor.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/03SensorMonitor/bin || mkdir -p $(INSTALL_ROOT)/opt/03SensorMonitor/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/03SensorMonitor/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/03SensorMonitor/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/03SensorMonitor/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

